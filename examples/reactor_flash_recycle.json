{
  "name": "reactor-flash-recycle",
  "feeds": {
    "feed": {"flows": {"A": 5.6, "I": 2.4}, "temperature": 330.0, "pressure": 200000.0}
  },
  "units": [
    {"name": "mixer", "type": "mixer", "inlets": ["feed", "recycle"], "outlets": ["reactor-in"]},
    {
      "name": "reactor",
      "type": "cstr",
      "inlets": ["reactor-in"],
      "outlets": ["reactor-out"],
      "params": {"reactant": "A", "product": "B", "rate_constant": 0.023, "volume": 2.0, "volumetric_flow": 0.02}
    },
    {
      "name": "drum",
      "type": "flash",
      "inlets": ["reactor-out"],
      "outlets": ["vapour", "liquid"],
      "params": {
        "k_values": {"A": 5.0, "I": 1.0, "B": 0.3333333333333333},
        "molar_masses": {"A": 0.06, "I": 0.028, "B": 0.06},
        "liquid_density": 800.0,
        "souders_brown_k": 0.07,
        "height_to_diameter": 4.0
      }
    },
    {
      "name": "purge-split",
      "type": "splitter",
      "inlets": ["vapour"],
      "outlets": ["purge", "recycle"],
      "params": {"fractions": [0.2, 0.8]}
    }
  ],
  "tear": {"streams": ["recycle"], "method": "wegstein", "tol": 1e-10, "max_iter": 100}
}
