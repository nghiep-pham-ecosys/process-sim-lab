{
  "id": "flash-ternary",
  "description": "Ternary isothermal flash built from a chosen answer: psi = 1/4, x = (0.1, 0.3, 0.6).",
  "source": "tests/test_flash.py TernaryFlashTest.test_constructed_case: K = (5, 1, 1/3) and z = x (1 + psi (K - 1)) = (0.2, 0.3, 0.5) give psi = 0.25, x = (0.1, 0.3, 0.6), y = (0.5, 0.3, 0.2). Tolerance 1e-9 (the test's TOL).",
  "call": {
    "name": "flash_drum",
    "arguments": {
      "feed": {
        "flows": {
          "A": 2.0,
          "B": 3.0,
          "C": 5.0
        },
        "temperature": 320.0,
        "pressure": 300000.0
      },
      "k_values": {
        "A": 5.0,
        "B": 1.0,
        "C": 0.3333333333333333
      }
    }
  },
  "expected": [
    {
      "pointer": "/phase",
      "value": "two-phase"
    },
    {
      "pointer": "/vapour_fraction",
      "value": 0.25,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/x/A",
      "value": 0.1,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/x/B",
      "value": 0.3,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/x/C",
      "value": 0.6,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/y/A",
      "value": 0.5,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/y/B",
      "value": 0.3,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/y/C",
      "value": 0.2,
      "abs_tol": 1e-09
    }
  ]
}
