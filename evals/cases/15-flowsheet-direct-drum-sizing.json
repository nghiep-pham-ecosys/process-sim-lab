{
  "id": "flowsheet-direct-drum-sizing",
  "description": "The week-3 flowsheet solved by direct substitution; the recycle and every sizing output of the flash drum match the hand check.",
  "source": "tests/test_flowsheet.py ExampleFlowsheetTest test_direct_substitution_reaches_the_same_answer_more_slowly (recycle (1, 3/5, 2/5) mol/s, tolerance 1e-8 mol/s) and SizingTest test_drum_is_sized_from_the_converged_vapour; the drum numbers are hand-checked in tests/test_flash_drum_sizing.py HandCheckedDrumTest: M_V = 0.0504 kg/mol, rho_V = 3.673774 kg/m3, Q_V = 0.0342971583 m3/s, u_max = 1.0305934 m/s, D = 0.2058451 m, H = 4 D = 0.8233803 m, V = 0.0274013 m3. Tolerance 1e-9 on the sizing fields (SizingTest's delta).",
  "call": {
    "name": "solve_flowsheet",
    "arguments": {
      "name": "reactor-flash-recycle",
      "feeds": {
        "feed": {
          "flows": {
            "A": 5.6,
            "I": 2.4
          },
          "temperature": 330.0,
          "pressure": 200000.0
        }
      },
      "units": [
        {
          "name": "mixer",
          "type": "mixer",
          "inlets": [
            "feed",
            "recycle"
          ],
          "outlets": [
            "reactor-in"
          ]
        },
        {
          "name": "reactor",
          "type": "cstr",
          "inlets": [
            "reactor-in"
          ],
          "outlets": [
            "reactor-out"
          ],
          "params": {
            "reactant": "A",
            "product": "B",
            "rate_constant": 0.023,
            "volume": 2.0,
            "volumetric_flow": 0.02
          }
        },
        {
          "name": "drum",
          "type": "flash",
          "inlets": [
            "reactor-out"
          ],
          "outlets": [
            "vapour",
            "liquid"
          ],
          "params": {
            "k_values": {
              "A": 5.0,
              "I": 1.0,
              "B": 0.3333333333333333
            },
            "molar_masses": {
              "A": 0.06,
              "I": 0.028,
              "B": 0.06
            },
            "liquid_density": 800.0,
            "souders_brown_k": 0.07,
            "height_to_diameter": 4.0
          }
        },
        {
          "name": "purge-split",
          "type": "splitter",
          "inlets": [
            "vapour"
          ],
          "outlets": [
            "purge",
            "recycle"
          ],
          "params": {
            "fractions": [
              0.2,
              0.8
            ]
          }
        }
      ],
      "tear": {
        "streams": [
          "recycle"
        ],
        "method": "direct",
        "tol": 1e-10,
        "max_iter": 100
      }
    }
  },
  "expected": [
    {
      "pointer": "/method",
      "value": "direct"
    },
    {
      "pointer": "/streams/recycle/flows/A",
      "value": 1.0,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/recycle/flows/I",
      "value": 0.6,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/recycle/flows/B",
      "value": 0.4,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/units/drum/sizing/diameter",
      "value": 0.205845063,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/units/drum/sizing/height",
      "value": 0.823380252,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/units/drum/sizing/volume",
      "value": 0.0274013045,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/units/drum/sizing/height_to_diameter",
      "value": 4.0,
      "abs_tol": 1e-12
    },
    {
      "pointer": "/units/drum/sizing/vapour_density",
      "value": 3.673773754,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/units/drum/sizing/vapour_volumetric_flow",
      "value": 0.0342971583,
      "abs_tol": 1e-09
    },
    {
      "pointer": "/units/drum/sizing/max_vapour_velocity",
      "value": 1.0305933741,
      "abs_tol": 1e-09
    }
  ]
}
