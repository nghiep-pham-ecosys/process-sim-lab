{
  "id": "flowsheet-tear-reactor-outlet",
  "description": "The week-3 flowsheet torn at the reactor outlet instead of the recycle, with a first guess equal to the feed; it reaches the same steady state.",
  "source": "tests/test_flowsheet.py ExampleFlowsheetTest test_tear_upstream_of_the_flash_with_initial_guess and constructed_case: reactor inlet (33/5, 3, 2/5), vapour (5/4, 3/4, 1/2), liquid (3/4, 9/4, 9/2), recycle (1, 3/5, 2/5) mol/s for (A, I, B). Tolerance 1e-8 mol/s on flows (the test's VALUE_TOL, tear tol 1e-10) and 1e-6 mol/s on the overall balance (the test's BALANCE_TOL).",
  "call": {
    "name": "solve_flowsheet",
    "arguments": {
      "name": "reactor-flash-recycle",
      "feeds": {
        "feed": {
          "flows": {
            "A": 5.6,
            "I": 2.4
          },
          "temperature": 330.0,
          "pressure": 200000.0
        }
      },
      "units": [
        {
          "name": "mixer",
          "type": "mixer",
          "inlets": [
            "feed",
            "recycle"
          ],
          "outlets": [
            "reactor-in"
          ]
        },
        {
          "name": "reactor",
          "type": "cstr",
          "inlets": [
            "reactor-in"
          ],
          "outlets": [
            "reactor-out"
          ],
          "params": {
            "reactant": "A",
            "product": "B",
            "rate_constant": 0.023,
            "volume": 2.0,
            "volumetric_flow": 0.02
          }
        },
        {
          "name": "drum",
          "type": "flash",
          "inlets": [
            "reactor-out"
          ],
          "outlets": [
            "vapour",
            "liquid"
          ],
          "params": {
            "k_values": {
              "A": 5.0,
              "I": 1.0,
              "B": 0.3333333333333333
            },
            "molar_masses": {
              "A": 0.06,
              "I": 0.028,
              "B": 0.06
            },
            "liquid_density": 800.0,
            "souders_brown_k": 0.07,
            "height_to_diameter": 4.0
          }
        },
        {
          "name": "purge-split",
          "type": "splitter",
          "inlets": [
            "vapour"
          ],
          "outlets": [
            "purge",
            "recycle"
          ],
          "params": {
            "fractions": [
              0.2,
              0.8
            ]
          }
        }
      ],
      "tear": {
        "streams": [
          "reactor-out"
        ],
        "initial": {
          "reactor-out": {
            "flows": {
              "A": 5.6,
              "I": 2.4,
              "B": 0.0
            },
            "temperature": 330.0,
            "pressure": 200000.0
          }
        },
        "method": "wegstein",
        "tol": 1e-10,
        "max_iter": 100
      }
    }
  },
  "expected": [
    {
      "pointer": "/streams/reactor-in/flows/A",
      "value": 6.6,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/reactor-in/flows/I",
      "value": 3.0,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/reactor-in/flows/B",
      "value": 0.4,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/vapour/flows/A",
      "value": 1.25,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/vapour/flows/I",
      "value": 0.75,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/vapour/flows/B",
      "value": 0.5,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/liquid/flows/A",
      "value": 0.75,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/liquid/flows/I",
      "value": 2.25,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/liquid/flows/B",
      "value": 4.5,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/recycle/flows/A",
      "value": 1.0,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/recycle/flows/I",
      "value": 0.6,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/streams/recycle/flows/B",
      "value": 0.4,
      "abs_tol": 1e-08
    },
    {
      "pointer": "/overall_balance/A",
      "value": 0.0,
      "abs_tol": 1e-06
    },
    {
      "pointer": "/overall_balance/I",
      "value": 0.0,
      "abs_tol": 1e-06
    },
    {
      "pointer": "/overall_balance/B",
      "value": 0.0,
      "abs_tol": 1e-06
    }
  ]
}
